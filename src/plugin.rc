#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,3,0
 PRODUCTVERSION 0,2,3,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "AutoScylla x64dbg plugin (dump + import reconstruction)"
            VALUE "InternalName", "AutoScylla"
            VALUE "OriginalFilename", "AutoScylla.dp64"
            VALUE "ProductVersion", "0.2.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

/* Minimal manual control: Fix Dump dialog (module name + output path). */
#define IDD_FIX_DIALOG  2000
#define IDC_MODULE      2001
#define IDC_PATH        2002
#define IDC_OEP         2003

IDD_FIX_DIALOG DIALOGEX 0, 0, 300, 150
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "AutoScylla - Fix Dump"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Modulname (z. B. notepad.exe):", -1, 10, 10, 280, 12
    EDITTEXT        IDC_MODULE, 10, 24, 280, 14, ES_AUTOHSCROLL
    LTEXT           "Ausgabe-Pfad:", -1, 10, 46, 280, 12
    EDITTEXT        IDC_PATH, 10, 60, 280, 14, ES_AUTOHSCROLL
    LTEXT           "OEP als RVA (optional, z. B. 0x1440):", -1, 10, 82, 280, 12
    EDITTEXT        IDC_OEP, 10, 96, 280, 14, ES_AUTOHSCROLL
    LTEXT           "Tipp: Modulnamen aus dem Modules-Tab kopieren.", -1, 10, 118, 280, 12
    DEFPUSHBUTTON   "OK", IDOK, 150, 132, 60, 14
    PUSHBUTTON      "Abbrechen", IDCANCEL, 220, 132, 70, 14
END
